[Unit]
Description=Mirai lab out-of-band SOC monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Mirai-Botnet-Simulation-Lab/monitor
Environment=SOC_BIND=185.10.20.110
Environment=SOC_PORT=8080
ExecStart=/usr/bin/python3 backend/server.py
Restart=on-failure
RestartSec=2
MemoryMax=256M
CPUWeight=900
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
